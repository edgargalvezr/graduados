{% extends 'base.html.twig' %}

{% block title %}Graduado{% endblock %}

{% block titlebody %}Graduado{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row justify-content-center">
            {% for graduado in graduados %}
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-primary fw-bold">
                                {{ graduado.nombres }} {{ graduado.apellidos }}
                            </h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{ graduado.carrera }}</h6>

                            <p class="card-text mt-3 mb-1">
                                <strong>Cédula:</strong> {{ graduado.cedula }}
                            </p>
                            <p class="card-text text-muted small">
                                <i class="fas fa-clock"></i> Act: {{ graduado.updatedAt|date('d/m/Y H:i') }}
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pb-3 pt-0">
                            <div class="d-grid gap-2">
                                <a href="{{ path('app_graduado_perfil_edit', {'id': graduado.id}) }}"
                                   class="btn btn-primary btn-lg stretched-link">
                                    Actualizar Información
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">No se encontraron registros</div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
